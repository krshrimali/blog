{{- $section := site.GetPage "section" "posts" -}}
{{- $pages := sort $section.RegularPages "Date" "desc" -}}
[
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end }}
  {
    "title": {{ $p.Title | jsonify }},
    "permalink": {{ $p.Permalink | jsonify }},
    "date": {{ $p.Date.Format "Jan 2, 2006" | jsonify }},
    "summary": {{ $p.Summary | plainify | truncate 200 | htmlUnescape | jsonify }},
    "tags": {{ $p.Params.tags | jsonify }},
    "categories": {{ $p.Params.categories | jsonify }}
  }
{{- end -}}
]
